{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:nlbcli:account-transactions:v1",
  "title": "nlbcli account transactions v1",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "date",
      "recipient",
      "description",
      "status",
      "amount",
      "fee",
      "balance"
    ],
    "properties": {
      "date": {
        "type": ["string", "null"],
        "format": "date",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "recipient": {
        "type": ["string", "null"]
      },
      "description": {
        "type": ["string", "null"]
      },
      "status": {
        "type": ["string", "null"]
      },
      "amount": {
        "type": ["string", "null"],
        "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
      },
      "fee": {
        "type": ["string", "null"],
        "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
      },
      "balance": {
        "type": ["string", "null"],
        "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
      }
    }
  }
}
