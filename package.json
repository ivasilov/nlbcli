{
  "name": "nlbcli",
  "type": "module",
  "version": "0.0.3",
  "description": "A CLI tool for managing NLB Tutunska accounts and cards.",
  "author": "Ivan Vasilov <vasilov.ivan@mail.com>",
  "license": "MIT",
  "homepage": "https://github.com/ivasilov/nlbcli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivasilov/nlbcli.git"
  },
  "bugs": {
    "url": "https://github.com/ivasilov/nlbcli/issues"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "nlbcli": "./dist/index.mjs"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "start": "node dist/index.mjs",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@effect/cli": "^0.73.2",
    "@effect/platform": "^0.94.5",
    "@effect/platform-node": "^0.104.1",
    "cheerio": "^1.2.0",
    "effect": "^3.19.19"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@types/node": "^22.0.0",
    "bumpp": "^10.3.2",
    "tsdown": "^0.18.1",
    "typescript": "^5.7.0",
    "ultracite": "7.2.5",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "nlb",
    "banking",
    "cli"
  ]
}
